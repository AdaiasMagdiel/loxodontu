<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <!--
                These only ever execute inside the sandboxed child process
                spawned for a source-code edge function (see
                EdgeFunctionRunner::invokeSource()), never in the PHPUnit
                process itself, so Xdebug/PCOV can't observe them running —
                same reasoning as SandboxRunner.php below. They're covered
                behaviorally through EdgeFunctionsTest's database-bridge
                tests, just not line-by-line here.
            -->
            <file>app/Edge/SandboxRunner.php</file>
            <file>app/Edge/Db.php</file>
            <file>app/Edge/DbQuery.php</file>
            <file>app/Edge/DbResult.php</file>
        </exclude>
    </source>
    <php>
        <env name="ENV" value="testing" force="true"/>
        <env name="DB_MODE" value="testing" force="true"/>
    </php>
</phpunit>
