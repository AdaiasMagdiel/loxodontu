ENV="development"
DEBUG="true"
APP_URL=

# 32-byte key, base64-encoded, used to encrypt SMTP passwords / email-API
# keys stored per project. Generate with: openssl rand -base64 32
APP_KEY=

# --- Cron worker

CRON_WORKER_TOKEN=
CRON_WORKER_LIMIT=10
CRON_ALLOW_COMMANDS=false

# --- Edge functions

# Optional: force the PHP CLI binary used by the edge function sandbox.
# Useful on shared hosting where PHP_BINARY may point to lsphp/php-cgi.
EDGE_PHP_BINARY=

# --- Storage

# Optional: absolute path where uploaded files are written to disk.
# Defaults to "storage/files" inside the project root.
STORAGE_PATH=

# --- Database

DB_MODE="development"

# Development
DB_HOST_DEV="localhost"
DB_PORT_DEV=3306
DB_USERNAME_DEV="root"
DB_PASSWORD_DEV="root"
DB_DATABASE_DEV=

# Production
DB_HOST_PROD=
DB_PORT_PROD=
DB_USERNAME_PROD=
DB_PASSWORD_PROD=
DB_DATABASE_PROD=

# Testing (used by `composer test` / CI; DB_MODE is forced to "testing" there
# regardless of what's set above — see tests/Pest.php)
DB_HOST_TEST="localhost"
DB_PORT_TEST=3306
DB_USERNAME_TEST="root"
DB_PASSWORD_TEST="root"
DB_DATABASE_TEST="loxodontu_test"
