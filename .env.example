ENV="development"
DEBUG="true"
APP_URL=


# --- Database

DB_MODE="development"

# Development
DB_HOST_DEV="localhost"
DB_PORT_DEV=3306
DB_USERNAME_DEV="root"
DB_PASSWORD_DEV="root"
DB_DATABASE_DEV=

# Production
DB_HOST_PROD=
DB_PORT_PROD=
DB_USERNAME_PROD=
DB_PASSWORD_PROD=
DB_DATABASE_PROD=

# Testing (used by `composer test` / CI; DB_MODE is forced to "testing" there
# regardless of what's set above — see tests/Pest.php)
DB_HOST_TEST="localhost"
DB_PORT_TEST=3306
DB_USERNAME_TEST="root"
DB_PASSWORD_TEST="root"
DB_DATABASE_TEST="loxodontu_test"
